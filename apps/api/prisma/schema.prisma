generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  passwordHash           String
  name                   String
  avatarUrl              String?
  isEmailVerified        Boolean   @default(false)
  emailVerificationToken String?
  passwordResetToken     String?
  passwordResetExpires   DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  memberships            OrganizationMember[]
  refreshTokens          RefreshToken[]
  userPreference         UserPreference?
  activityLogs           ActivityLog[]
  createdRecords         GenericRecord[]
  createdCustomers       Customer[]
  createdQuotations      Quotation[]
  createdSubscriptions   Subscription[]
  recordedPayments       Payment[]

  @@map("users")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       OrganizationMember[]
  roles         Role[]
  settings      OrganizationSetting?
  records       GenericRecord[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  customers     Customer[]
  products      Product[]
  plans         Plan[]
  quotations    Quotation[]
  subscriptions Subscription[]
  invoices      Invoice[]
  discounts     Discount[]
  payments      Payment[]
  taxRules      TaxRule[]

  @@map("organizations")
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  roleId         String
  status         MemberStatus @default(ACTIVE)
  joinedAt       DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model Role {
  id             String           @id @default(uuid())
  organizationId String?
  name           String
  description    String?
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  members        OrganizationMember[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String?
  module      String
  createdAt   DateTime         @default(now())

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id              String   @id @default(uuid())
  tokenHash       String   @unique
  userId          String
  expiresAt       DateTime
  revoked         Boolean  @default(false)
  replacedByToken String?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================================
// Core Domain Models: Customer, Product, Plan, Quote, Subscription, Invoice
// ============================================================================

model Customer {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  email          String
  phone          String?
  company        String?
  address        String?
  notes          String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  quotations     Quotation[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  payments       Payment[]

  @@index([organizationId, email])
  @@index([organizationId, createdAt])
  @@map("customers")
}

model Product {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  type           String   // e.g. "Software", "Add-on", "Service"
  salesPrice     Float
  costPrice      Float?   // Masked from Staff
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variants          ProductVariant[]
  plans             Plan[]
  quotationLines    QuotationLine[]
  subscriptionLines SubscriptionLine[]

  @@index([organizationId, name])
  @@map("products")
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  name            String   // e.g. "Odoo Brand (+560)"
  additionalPrice Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationLines    QuotationLine[]
  subscriptionLines SubscriptionLine[]

  @@map("product_variants")
}

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Plan {
  id               String           @id @default(uuid())
  organizationId   String
  productId        String
  name             String
  price            Float
  billingFrequency BillingFrequency @default(MONTHLY)
  minQuantity      Int              @default(1)
  startDate        DateTime?
  endDate          DateTime?
  autoCloseOnEnd   Boolean          @default(false)
  allowEarlyClose  Boolean          @default(true)
  allowPause       Boolean          @default(true)
  allowRenewal     Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]

  @@index([organizationId, billingFrequency])
  @@map("plans")
}

enum QuotationStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  EXPIRED
  CANCELLED
}

model Quotation {
  id              String          @id @default(uuid())
  organizationId  String
  quotationNumber String
  customerId      String
  templateName    String?
  validDays       Int             @default(15)
  expiryDate      DateTime
  subtotal        Float           @default(0)
  discountAmount  Float           @default(0)
  taxAmount       Float           @default(0)
  totalAmount     Float           @default(0)
  status          QuotationStatus @default(DRAFT)
  notes           String?
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creator       User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines         QuotationLine[]
  subscriptions Subscription[]

  @@unique([organizationId, quotationNumber])
  @@index([organizationId, status])
  @@map("quotations")
}

model QuotationLine {
  id          String   @id @default(uuid())
  quotationId String
  productId   String
  variantId   String?
  quantity    Int      @default(1)
  unitPrice   Float
  taxRate     Float    @default(0)
  taxAmount   Float    @default(0)
  lineTotal   Float

  quotation Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("quotation_lines")
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

model Subscription {
  id                 String             @id @default(uuid())
  organizationId     String
  subscriptionNumber String
  customerId         String
  planId             String
  quotationId        String?
  startDate          DateTime           @default(now())
  expiryDate         DateTime?
  billingFrequency   BillingFrequency   @default(MONTHLY)
  paymentTerms       String             @default("Net 30")
  subtotal           Float              @default(0)
  discountAmount     Float              @default(0)
  taxAmount          Float              @default(0)
  totalAmount        Float              @default(0)
  status             SubscriptionStatus @default(DRAFT)
  createdById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan         Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  quotation    Quotation?         @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  creator      User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines        SubscriptionLine[]
  invoices     Invoice[]

  @@unique([organizationId, subscriptionNumber])
  @@index([organizationId, status])
  @@map("subscriptions")
}

model SubscriptionLine {
  id             String   @id @default(uuid())
  subscriptionId String
  productId      String
  variantId      String?
  quantity       Int      @default(1)
  unitPrice      Float
  taxRate        Float    @default(0)
  taxAmount      Float    @default(0)
  lineTotal      Float

  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("subscription_lines")
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

model Invoice {
  id                String        @id @default(uuid())
  organizationId    String
  invoiceNumber     String
  subscriptionId    String?
  customerId        String
  invoiceDate       DateTime      @default(now())
  dueDate           DateTime
  subtotal          Float         @default(0)
  discountAmount    Float         @default(0)
  taxAmount         Float         @default(0)
  totalAmount       Float         @default(0)
  paidAmount        Float         @default(0)
  outstandingAmount Float         @default(0)
  status            InvoiceStatus @default(DRAFT)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines        InvoiceLine[]
  payments     Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id          String @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int    @default(1)
  unitPrice   Float
  taxRate     Float  @default(0)
  taxAmount   Float  @default(0)
  lineTotal   Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_lines")
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountScope {
  WHOLE_SUBSCRIPTION
  SPECIFIC_PRODUCTS
}

model Discount {
  id                   String        @id @default(uuid())
  organizationId       String
  name                 String
  code                 String
  type                 DiscountType  @default(PERCENTAGE)
  value                Float
  minPurchase          Float         @default(0)
  minQuantity          Int           @default(0)
  startDate            DateTime?
  endDate              DateTime?
  maxUsage             Int?
  usedCount            Int           @default(0)
  scope                DiscountScope @default(WHOLE_SUBSCRIPTION)
  applicableProductIds String[]      @default([])
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, code])
  @@map("discounts")
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  CHECK
  CASH
  OTHER
}

model Payment {
  id               String        @id @default(uuid())
  organizationId   String
  paymentReference String
  invoiceId        String
  customerId       String
  amount           Float
  paymentMethod    PaymentMethod @default(BANK_TRANSFER)
  paymentDate      DateTime      @default(now())
  note             String?
  recordedById     String
  createdAt        DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  recordedBy   User         @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, paymentReference])
  @@index([organizationId, invoiceId])
  @@map("payments")
}

model TaxRule {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  ratePercentage Float
  jurisdiction   String   @default("Standard")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("tax_rules")
}

// ============================================================================
// Starter Generic Records, Notifications & Logs
// ============================================================================

enum RecordStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RecordPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model GenericRecord {
  id             String         @id @default(uuid())
  organizationId String
  title          String
  description    String?
  status         RecordStatus   @default(DRAFT)
  priority       RecordPriority @default(MEDIUM)
  category       String
  tags           String[]       @default([])
  metadata       Json?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([organizationId, createdAt])
  @@map("generic_records")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  SECURITY
  SYSTEM
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  userId         String?
  title          String
  message        String
  type           NotificationType @default(INFO)
  isRead         Boolean          @default(false)
  link           String?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, isRead])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model ActivityLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  action         String
  entity         String
  entityId       String?
  details        Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, entity])
  @@map("activity_logs")
}

model UserPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  theme              String   @default("system")
  accentColor        String   @default("indigo")
  density            String   @default("comfortable")
  language           String   @default("en")
  timezone           String   @default("UTC")
  dateFormat         String   @default("YYYY-MM-DD")
  emailNotifications Boolean  @default(true)
  inAppNotifications Boolean  @default(true)
  marketingEmails    Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model OrganizationSetting {
  id                 String   @id @default(uuid())
  organizationId     String   @unique
  displayName        String
  supportEmail       String?
  timezone           String   @default("UTC")
  dateFormat         String   @default("YYYY-MM-DD")
  allowMemberInvites Boolean  @default(true)
  enforce2FA         Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}
