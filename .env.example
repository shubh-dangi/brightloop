# ==============================================================================
# UNKNOWN SaaS Starter Kit - Environment Configuration Example
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_NAME=UNKNOWN
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unknown_db?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Security (Generate secure random strings in production!)
JWT_ACCESS_SECRET=unknown_super_secret_access_jwt_key_2026_dev_min_32_chars!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=unknown_super_secret_refresh_jwt_key_2026_dev_min_32_chars!
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Email Integration (Resend ready)
RESEND_API_KEY=re_placeholder_key
EMAIL_FROM=noreply@unknown.local

# Storage Integration (AWS S3 ready)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=placeholder_access_key
AWS_SECRET_ACCESS_KEY=placeholder_secret_key
AWS_S3_BUCKET=unknown-saas-uploads

# Monitoring & Logging
LOG_LEVEL=debug
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
