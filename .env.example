# ==============================================================================
# Brightloop Subscription Management System — Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - NEVER commit sensitive production values or secrets to version control.
# - In production, generate cryptographically secure random secrets:
#   openssl rand -base64 48
# - Ensure PostgreSQL connection uses SSL (?sslmode=require) in production.
# ==============================================================================

# Server & Runtime Environment
NODE_ENV=production
PORT=4000
API_PREFIX=api/v1
APP_NAME=Brightloop
FRONTEND_URL=https://brightloop-chi.vercel.app

# Database (PostgreSQL with SSL enabled in production)
# Development: postgresql://postgres:postgres@localhost:5432/brightloop_db?schema=public
# Production:  postgresql://<user>:<password>@<db-host>:5432/<dbname>?schema=public&sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/brightloop_prod?schema=public&sslmode=require

# Cryptographic Authentication Secrets (Minimum 256-bit entropy recommended)
# Generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_RANDOM_ACCESS_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_RANDOM_REFRESH_SECRET_MIN_64_CHARS
JWT_REFRESH_EXPIRATION=7d

# CORS Allowed Origin
CORS_ORIGIN=https://brightloop-chi.vercel.app

# Rate Limiting & DoS Protection (Global Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Email Delivery (Resend / SMTP)
RESEND_API_KEY=re_live_placeholder_secret_key
EMAIL_FROM=billing@brightloop.local

# Cloud Object Storage (AWS S3 / Cloudflare R2 / MinIO)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA_PLACEHOLDER_KEY_ID
AWS_SECRET_ACCESS_KEY=PLACEHOLDER_SECRET_ACCESS_KEY
AWS_S3_BUCKET=brightloop-customer-invoices

# Observability, Error Tracking & Audit
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
