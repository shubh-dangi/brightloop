{
  "name": "brightloop-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Brightloop - Enterprise Subscription Management & Recurring Billing Platform",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.0.0 <=24.x"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter=@brightloop/web dev",
    "dev:api": "pnpm --filter=@brightloop/api dev",
    "build": "pnpm --filter=@brightloop/web build && pnpm --filter=@brightloop/api build",
    "lint": "pnpm --filter=@brightloop/web lint && pnpm --filter=@brightloop/api lint",
    "typecheck": "pnpm --filter=@brightloop/web typecheck && pnpm --filter=@brightloop/api typecheck",
    "test": "pnpm --filter=@brightloop/web test && pnpm --filter=@brightloop/api test",
    "test:e2e": "pnpm --filter=@brightloop/api test:e2e",
    "db:up": "docker compose up -d",
    "db:generate": "pnpm --filter=@brightloop/api db:generate",
    "db:migrate": "pnpm --filter=@brightloop/api db:migrate",
    "db:seed": "pnpm --filter=@brightloop/api db:seed",
    "db:reset": "pnpm --filter=@brightloop/api db:reset",
    "setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "clean": "rimraf node_modules"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.67.2",
    "esbuild-wasm": "^0.28.2",
    "playwright-core": "^1.64.1",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
