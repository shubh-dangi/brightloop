{
  "name": "subpulse-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Subpulse - Enterprise Subscription Management & Recurring Billing Platform",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@subpulse/web",
    "dev:api": "turbo run dev --filter=@subpulse/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter=@subpulse/api db:generate",
    "db:migrate": "pnpm --filter=@subpulse/api db:migrate",
    "db:seed": "pnpm --filter=@subpulse/api db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
